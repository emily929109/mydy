
<style>


    .star_color {
        color: #E4603C;
    }

    /* 驗證碼 */
    .progessbar {
        position: relative;
        text-align: center;
        border: 1px dashed blue;
        height: 16px;
        width: 100%;
    }

        .progessbar .text {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            line-height: 16px;
            z-index: 10;
            color: black;
        }

        .progessbar .bar {
            position: absolute;
            left: 0;
            top: 0;
            height: 16px;
            background-color: DeepSkyBlue;
        }

    .snedCode_button {
        background-color: #00af9a;
        border-color: #00af9a;
        color: white;
    }

    .disFunc {
        pointer-events: none;
    }
</style>


<div id="app" class="mt-3" style="min-height:600px">


    <div class="row justify-content-center pt-4">
        <div class="col-sm-10 col-lg-7 col-xxl-5">
            <span>{{test_order}}</span>
            <div class="d-flex justify-content-center mb-2">
                <h3 class="fw-bold p-2" style="color:#00af9a">消費內容</h3>
            </div>
            <div class="card mb-3" style="border:solid 1px #00af9a;box-shadow:0 7px 14px 0 rgba(0, 175, 154, 0.1), 0 3px 6px 0 rgba(0, 0, 0, 0.07)">
                <div class="overflow-hidden mb-3" style="min-width: 12rem">
                    <div class="d-flex">
                        <div class="p-2 flex-grow-1">商店名稱/代號<br><span class="fw-bold fs-1">{{json.store_name}}/{{json.store_no}}</span></div>
