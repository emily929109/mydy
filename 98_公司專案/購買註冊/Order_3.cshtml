                            <a data-bs-toggle="tooltip" data-bs-placement="top" title="月付金額不可低於800元">
                                <span class="fas fa-info-circle"></span>
                            </a>
                            <br>
                            <input style="width:11rem;" class="form-control" type="number" placeholder="請輸入金額" @@input="cashChanged($event)" v-model.trim="json.price" />
                        </div>
                    </div>
                    <div class="dropdown-divider"></div>
                    <div class="d-flex justify-content-center mb-2">
                        <div class="">
