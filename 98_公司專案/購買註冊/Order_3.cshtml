                            </select>
                        </div>
                    </div>
                    <div v-if="showPayDetail">
                        <div class="dropdown-divider"></div>
                        <div class="d-flex">
                            <div class="p-2 flex-grow-1">毎月應繳</div>
                            <div class="p-2 fs-2 fs-md-2 fs-lg-2" style="color:#00af9a;">NT${{parseInt(json.kc_perd_fee).toLocaleString() }}</div>
                        </div>
                        @*<div class="d-flex">
                                <div class="p-2 flex-grow-1">手續費</div>
                                <div class="p-2">${{json.exp.toLocaleString()}} </div>
                            </div>
                            <div class="d-flex">
                                <div class="p-2 flex-grow-1">應付總金額</div>
                                <div class="p-2">${{(parseInt(json.price) +  (json.kc_perd_fee * selected) - parseInt(json.price)).toLocaleString()}}</div>
                            </div>*@
