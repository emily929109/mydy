<link href="~/css/default.css" rel="stylesheet" />
<link href="~/css/btn/btn.css" rel="stylesheet" />
<link href="~/css/cart.css?v=2.0" rel="stylesheet">
<script src="~/js/font-awesome/font-awesome.js"></script>
<style>


    .star_color {
        color: #E4603C;
    }

    /* 驗證碼 */
    .progessbar {
        position: relative;
        text-align: center;
        border: 1px dashed blue;
        height: 16px;
        width: 100%;
    }

    .progessbar .text {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        line-height: 16px;
        z-index: 10;
        color: black;
    }

    .progessbar .bar {
        position: absolute;
        left: 0;
        top: 0;
        height: 16px;
        background-color: DeepSkyBlue;
    }

    .snedCode_button {
        background-color: #00af9a;
        border-color: #00af9a;
        color: white;
    }

    .disFunc {
        pointer-events: none;
    }

    /* 覆寫cart.css */
    .orderPurchase.cart-store-block {
        border: 2px solid #00b099;
    }

    .orderPurchase .cart-store-header {
        border-left: none;
        background-color: #00b099;
        padding: 1em;
        color: #fff;
    }

    .orderPurchase .cart-table-header {
        background: #ebfcf97a;
    }

    .btn-wrapper > a {
        flex: 1 0 0;
    }
</style>


<div id="app" class="mt-3">


    <div class="row justify-content-center py-4">
        <div class="col-sm-10 col-lg-7 col-xxl-5">
            <div class="d-flex justify-content-center mb-2">
                <span>{{test_order}}</span>
                <h3 class="fw-bold p-2" style="color:#00af9a">消費內容</h3>
            </div>
                                          
            <div class="cart-store-block orderPurchase">
                <!-- 店家 header -->
                <div class="cart-store-header">
                    <i class="fa-solid fa-store ms-1"></i>
                    <span>{{json.item}}/{{json.store_no}}</span>
                </div>

                <!-- 商品列表 -->
                <div class="cart-table-header d-none d-md-flex">
                    <div class="cart-col-img"></div>
                    <div class="cart-col-info">商品</div>
                    <div class="cart-col-price">單價</div>
                    <div class="cart-col-qty">數量</div>
                    <div class="cart-col-sub">小計</div>
                </div>

                <div class="cart-item-row" v-for="v in json.item_list">
                    @*<img :src="vv.ProducBase64" class="cart-item-img" :alt="vv.product_id" />*@
                    <div class="cart-item-info">
                        <div class="cart-item-name">{{v.item}}</div>
                        @*<div class="cart-item-spec">
                                規格：
                            </div>*@
                        <div class="cart-item-price d-md-none mt-1">
                            NT${{parseInt(v.cash).toLocaleString()}}
                        </div>
                    </div>
                    <div class="cart-item-price d-none d-md-block"
                         style="min-width: 80px; text-align: center">
                        NT${{parseInt(v.cash).toLocaleString()}}
                    </div>
                    <div style="min-width: 90px; text-align: center">
                        <span>{{v.buy_qty}}</span>
                    </div>
                    <div class="cart-item-subtotal d-none d-md-block">
                        NT${{parseInt(v.cash) * v.buy_qty}}
                    </div>
                </div>

                <!-- 底部 : 總計、運費、選分期 -->
                <div class="d-flex flex-column align-items-end p-3 border-top"
                     style="font-size: 0.9rem; background: #ebfcf97a; border-radius: 0 0 8px 8px; ">
                    <div class="mb-1">
                        運費：<span> NT${{json.shipping_fee}} </span>
                    </div>
                    <div class="mb-1">
                        總計：<span>NT${{parseInt(json.total_cash).toLocaleString()}}</span>
                    </div>


                </div>
                <!-- 底部 : 選分期 -->
                <div class=" p-3 border-top"
                     style="font-size: 0.9rem; background: #ebfcf97a; border-radius: 0 0 8px 8px; ">
                    <div class="mb-1 d-flex justify-content-between align-items-center">
                        <div class="fs-0"> 分期期數</div>
                        <select @@change="Change(selected)" v-model="selected" class="form-select js-choice w-auto" id="organizerSingle" size="1" name="organizerSingle" data-options='{"removeItemButton":true,"placeholder":true}'>
                            <option value="">--選擇期數--</option>
                            <option v-for="item in periods" :key="item" :value="item" v-text="item"></option>
                        </select>
                    </div>
                </div>

                <!-- 底部 : 每月應繳 -->
                <div class=" p-3"
                     style="font-size: 0.9rem; background: #ebfcf97a; border-radius: 0 0 8px 8px; ">
                    <div class="mb-1 d-flex justify-content-between">
                        <div class="fs-1 fw-bold">每月應繳</div>
                        <div class="fs-2 fw-bold price-red">NT${{parseInt(json.kc_perd_fee).toLocaleString() }}</div>
                    </div>
                    <button class="btn btn-primary mt-4 mb-3 d-block mx-auto" style="background-color:#00af9a;border-color:#00af9a" type="button" @@click="showOTP(selected,parseInt(json.total_cash))">確認訂單</button>
                </div>




            </div>
        </div>


        @* OTP訊息 *@
        <div class="modal fade" id="otp_msg" tabindex="-1" data-bs-keyboard="false" data-bs-backdrop="static" aria-labelledby="tooltippopoversLabel" aria-hidden="true" style="z-index:10001">
            <div class="modal-dialog mt-6" role="document">
                <div class="modal-content border-0">
                    <div class="position-absolute top-0 end-0 mt-2 me-2 z-index-1">
                        <button class="btn-close btn btn-sm btn-circle d-flex flex-center transition-base" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0">
                        <div class="bg-light rounded-top-lg py-3 ps-4 pe-6">
                            <h4 class="mb-1  fw-bold" style="color:#00af9a">確定結帳</h4>
                        </div>
                        <div class="content-wrapper p-3">
                            <div v-show="showBar" class="progessbar mb-3">
                                <div class="text"></div>
                                <div class="bar"></div>
                            </div>
                            <div class="mb-3">
                                <div class="d-inline-block mb-2 me-2">發送至&nbsp;{{mobile}}&nbsp;&nbsp;</div>
                                <div :class="[sendCoded ? 'btn-secondary disFunc' : 'snedCode_button','btn']" @@click="sendOTP()">發送驗證碼</div>
                            </div>
                            <input class="form-control mb-3" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="\d{6}" placeholder="請輸入OTP驗證碼" v-model.trim="verify_code" />
              
                            <div v-show="showtxtMsg" class="mb-3 mb-md-5">
                                <h6 class="text-danger">請於5分鐘內輸入簡訊驗證碼</h6>
                            </div>
                            <button class="btn btn-primary" @@click="confirm(json,selected)" :disabled="isSubmitting" type="submit">確 認</button>



                     


                        </div>

                    </div>
                </div>
            </div>
        </div>

        @* 已完成訂單 *@
        <div class="modal fade" id="orderConfirm_modal" tabindex="-1" data-bs-keyboard="false" data-bs-backdrop="static" aria-labelledby="tooltippopoversLabel" aria-hidden="true" style="z-index:10001">
            <div class="modal-dialog mt-6" role="document">
                <div class="modal-content border-0">
                    <div class="modal-header">
                        <h5 class="modal-title primary-title">訂購完成 尚待店家確認</h5>
                    </div>
                    <div class="modal-body fs-md-1 fw-bold">
                        <div>消費時間：{{confirmOrder.kc_updt_date}}</div>
                        <div>商店名稱：{{confirmOrder.store_name}}</div>
                        <div class="info-content-list">
                            <div>商品名稱：</div>
                            <div v-for="(prod, index) in confirmOrder.item_list"
                                 :key="index"
                                 class="product-name-item ms-2">
                                {{ prod.item }}
                            </div>
                        </div>
                        <div>共分幾期：{{confirmOrder.kc_loan_perd}}</div>
                        <div class="mb-md-3">毎期應繳：{{confirmOrder.kc_perd_fee}}</div>
                       
                        <div class="d-flex justify-content-center mb-4 btn-wrapper gap-3">
                            <a href="~/Home/Index"><button class="btn btn-primary" type="submit">返回首頁</button></a>
                            <a href="~/Home/MemberOrder"><button class="btn btn-primary" type="submit">查看訂單</button></a>
                        </div>

                        <div class="fs--1 text-danger">請於下個月10號前繳款，維持自身良好信譽，可於「我的帳單」中查詢</div>

                    </div>
                </div>
            </div>
        </div>

        @* 逾期不能消費 *@
        <div class="modal fade" id="notCust_modal" tabindex="-1" data-bs-keyboard="false" data-bs-backdrop="static" aria-labelledby="tooltippopoversLabel" aria-hidden="true" style="z-index:10001">
            <div class="modal-dialog mt-6" role="document">
                <div class="modal-content border-0">
                    <div class="position-absolute top-0 end-0 mt-2 me-2 z-index-1">
                        @*<button class="btn-close btn btn-sm btn-circle d-flex flex-center transition-base" data-bs-dismiss="modal" aria-label="Close"></button>*@
                    </div>
                    <div class="modal-body p-0">
                        <div class="bg-light rounded-top-lg py-3 ps-4 pe-6">
                            <h4 class="mb-1 fw-bold" style="color:#00af9a;">未繳帳單</h4>
                        </div>
                        <div class="p-4 pb-0">
                            <div class="row">
                                <div class="col">
                                    <form class="mb-3">
                                        <div class="mb-0">
                                            <label class="form-label fw-bold fs-1 fs-lg-1">您有逾期未繳帳單。<br>請先完成繳納後，再進行消費。</label>
                                        </div>

                                    </form>
                                    <div class="d-flex justify-content-center mb-4">
                                        <a href="~/Home/Account">
                                            <div style="background-color:#00af9a;border-color:#00af9a;" class="btn btn-primary px-5">立即繳款</div>
                                        </a>
                                    </div>
                                </div>


                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        @* 額度不足 *@
        @*<div class="modal fade" id="change_cash_modal" tabindex="-1" data-bs-keyboard="false" data-bs-backdrop="static" aria-labelledby="tooltippopoversLabel" aria-hidden="true" style="z-index:10001">
                <div class="modal-dialog mt-6" role="document">
                    <div class="modal-content border-0">
                        <div class="position-absolute top-0 end-0 mt-2 me-2 z-index-1">
                        </div>
                        <div class="modal-body p-0">
                            <div class="bg-light rounded-top-lg py-3 ps-4 pe-6">
                                <h4 class="mb-1 fw-bold" style="color:#00af9a;">額度不足</h4>
                            </div>
                            <div class="p-4 pb-0">
                                <div class="row">
                                    <div class="col">
                                        <form class="mb-3">
                                            <div class="mb-0">
                                                <label class="form-label fw-bold fs-1 fs-lg-1">帳戶可用額度不足，<br>您可以申請提高額度後，完成此筆訂單。</label>
                                            </div>
                                        </form>
                                        <div class="d-flex justify-content-center mb-4">
                                            <a href="~/Home/AmountUp">
                                                <div style="background-color:#00af9a;border-color:#00af9a;" class="btn btn-primary px-5">申請額度變更</div>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>*@

        @* 註冊帶訂單及超額 *@
        <div class="modal fade" id="nonMember_orderConfirm_modal" tabindex="-1" data-bs-keyboard="false" data-bs-backdrop="static" aria-labelledby="tooltippopoversLabel" aria-hidden="true" style="z-index:10001">
            <div class="modal-dialog mt-6" role="document">
                <div class="modal-content border-0">
                    <div class="position-absolute top-0 end-0 mt-2 me-2 z-index-1">
                        @*<button class="btn-close btn btn-sm btn-circle d-flex flex-center transition-base" data-bs-dismiss="modal" aria-label="Close"></button>*@
                    </div>
                    <div class="modal-body p-0">
                        <div class="bg-light rounded-top-lg py-3 ps-4 pe-6">
                            <h4 class="mb-1 fw-bold" style="color:#00af9a;">確定結帳</h4>
                        </div>
                        <div class="p-4 pb-0">
                            <div class="row">
                                <div class="col">
                                    <form class="mb-3">
                                        @*<div class="mb-0">
                                                <label class="form-label fw-bold fs-1 fs-lg-1">消費時間：{{confirmOrder.kc_updt_date}}</label>
                                            </div>*@

                                        <div class="mb-0">
                                            <label class="form-label fw-bold fs-1 fs-lg-1">商店名稱：{{json.item}}</label>
                                        </div>
                                        <div class="mb-0">
                                            <label class="form-label fw-bold fs-1 fs-lg-1">商品名稱：{{json.item}}</label>
                                        </div>
                                        <div class="mb-0">
                                            <label class="form-label fw-bold fs-1 fs-lg-1">商品明細：<span v-for="v in json.item_list">{{v.item}}</span></label>
                                        </div>
                                        <div class="mb-0">
                                            <label class="form-label fw-bold fs-1 fs-lg-1">共分幾期：{{selected}}</label>
                                        </div>
                                        <div class="mb-0">
                                            <label class="form-label fw-bold fs-1 fs-lg-1">毎期應繳：NT${{parseInt(json.kc_perd_fee).toLocaleString() }}</label>
                                        </div>
                                    </form>
                                    <div class="d-flex justify-content-center mb-4">
                                        <button @@click="nonMemberConfirm(json,selected)" style="background-color:#00af9a;border-color:#00af9a;" class="btn btn-primary" type="submit">確 認</button>
                                    </div>
                                </div>


                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        @* 照會時間(註冊帶訂單及超額) *@
        <div class="modal fade" id="finishmsg" tabindex="-1" data-bs-keyboard="false" data-bs-backdrop="static" aria-labelledby="tooltippopoversLabel" aria-hidden="true" style="z-index:10001">
            <div class="modal-dialog mt-6" role="document">
                <div class="modal-content border-0">
                    <div class="position-absolute top-0 end-0 mt-2 me-2 z-index-1">
                    </div>
                    <div class="modal-body p-0">
                        <div class="bg-light rounded-top-lg py-3 ps-4 pe-6">
                            <h4 class="mb-1 fw-bold" style="color:#00af9a" id="tooltippopoversLabel">申請完成</h4>
                        </div>
                        <div class="p-4 pb-0">
                            <div class="row">
                                <div class="col">
                                    @*<h5 style="margin-bottom:1.15rem" v-text="msg"></h5>*@
                                </div>
                            </div>
                        </div>
                        <div class="p-4 pb-0">
                            <div class="row">

                                <div class="col">
                                    <h5 class="p-2">已收到您的申請資料，我們將盡快審核您的本次訂單，審查結果將以簡訊通知。</h5>
                                    <h5 class="p-2">方便聯絡您的時間：</h5>
                                    <div class="form-check">
                                        <input class="form-check-input" id="inlineRadio1" type="radio" name="inlineRadioOptions" value="10:00~13:00" v-model="checked" />
                                        <label class="form-check-label fs-0 fs-lg-0" for="inlineRadio1">10: 00~13: 00</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" id="inlineRadio2" type="radio" name="inlineRadioOptions" value="13:00~16:00" v-model="checked" />
                                        <label class="form-check-label fs-0 fs-lg-0" for="inlineRadio2">13: 00~16: 00</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" id="inlineRadio3" type="radio" name="inlineRadioOptions" value="16:00~18:00" v-model="checked" />
                                        <label class="form-check-label fs-0 fs-lg-0" for="inlineRadio3">16: 00~18: 00</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" id="inlineRadio4" type="radio" name="inlineRadioOptions" value="18:00~21:00" v-model="checked" />
                                        <label class="form-check-label fs-0 fs-lg-0" for="inlineRadio4">18: 00~21: 00</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" id="inlineRadio5" type="radio" name="inlineRadioOptions" value="不限時間" v-model="checked" />
                                        <label class="form-check-label fs-0 fs-lg-0" for="inlineRadio5">不限時間</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="p-2 pb-0">
                            <div class="mb-3">
                                <div class="d-flex justify-content-center mb-2">
                                    <button class="btn btn-primary" style="width:19rem;background-color:#00af9a;border-color:#00af9a;" @@click="Close(checked)">完 成</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* 額度不足(超額) 提示申請額度 *@
        <div class="modal fade" id="cash-ample-modal" tabindex="-1" data-bs-keyboard="false" data-bs-backdrop="static" aria-labelledby="tooltippopoversLabel" aria-hidden="true" style="z-index:10001">
            <div class="modal-dialog mt-6" role="document">
                <div class="modal-content border-0">
                    <div class="position-absolute top-0 end-0 mt-2 me-2 z-index-1">
                        <button class="btn-close btn btn-sm btn-circle d-flex flex-center transition-base" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0">
                        <div class="bg-light rounded-top-lg p-3">
                            <h4 class="mb-1 fw-bold" style="color:#00af9a" id="tooltippopoversLabel">額度不足</h4>
                        </div>
                        <div class="p-3">
                            目前剩餘額度不足，無法完成訂單。<br />
                            您可以申請專人審核。<br />
                            審核通過後即自動完成訂單交易。
                        </div>

                        <div class="p-2 pb-0">
                            <div class="mb-3">
                                <div class="d-flex justify-content-center mb-2">
                                    <button class="btn btn-primary" style="width:19rem;background-color:#00af9a;border-color:#00af9a;" @@click="ApplyCash()">立即申請</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/common.js?v=1.1"></script>
<script src="~/js/orderPurchase.js?v=1.61112"></script>
