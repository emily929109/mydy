@* 用在發證日期民國月曆 *@
<link rel="stylesheet" href="//code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<script src="~/js/jqueryUI/jquery-ui-1.13.2.js"></script>
<link href="~/css/default.css" rel="stylesheet" />
<link href="~/css/nav-wizard.css" rel="stylesheet" />

<style>
    [v-cloak] {
        display: none !important;
    }

    .form-label {
        color: var(--falcon-600)
    }

    .star_color {
        color: #E4603C;
    }

    .helper-text {
        color: var(--falcon-600);
    }

    .error_border {
        border: solid 1px red !important;
        border-color: #e63757;
        padding-right: calc(1.5em + 0.625rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23e63757'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23e63757' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.15625rem) center;
        background-size: calc(0.75em + 0.3125rem) calc(0.75em + 0.3125rem);
    }

    .error_border_radio {
        border: solid 1px #e63757 !important;
    }

    .nomal_border {
        border: solid 1px #00d27a !important;
        border-color: #00d27a;
        padding-right: calc(1.5em + 0.625rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2300d27a' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.15625rem) center;
        background-size: calc(0.75em + 0.3125rem) calc(0.75em + 0.3125rem);
    }

    .error_msg {
        width: 100%;
        margin-top: 0.25rem;
        font-size: 75%;
        color: #e63757;
        font-style: italic;
    }

    /* btn 共用 */
    .btn-primary {
        background-color: var(--color-green);
        border-color: var(--color-green);
        border-radius: .25rem;
        width: 100%;
        max-width: 180px;
        display: block;
    }

        .btn-primary:focus {
            background-color: var(--color-dark-green);
            border-color: var(--color-green);
        }

    @@media (hover: hover) and (pointer: fine) {
        .btn-primary:hover {
            background-color: var(--color-dark-green);
            border-color: var(--color-green);
        }
    }

    @@media (max-width: 768px) {
        .btn-primary {
            max-width: none;
            margin-top: 1rem;
        }
    }

    /* 三欄欄位排版 */
    .three-col-wrapper > div {
        flex: 1 1 0;
    }

    @@media (max-width: 768px) {
        .three-col-wrapper {
            flex-direction: column;
        }
    }
</style>



<div id="app" v-cloak>

    <div class="row justify-content-center pt-0 pt-md-4">
        <div class="col-lg-7 col-sm-10 col-xxl-5 px-0 px-md-3">

            <div class="card mb-5">
                <div class="card-header bg-light pt-3 pb-2">
                    @* 流程 *@
                    <ul class="nav justify-content-between nav-wizard">
                        <li class="nav-item done"><span class="nav-item-circle-parent"><span class="nav-item-circle"><span class="fas fa-check"></span></span></span><span class="d-none d-md-block mt-1 fs--1">註冊會員</span></li>
                        <li class="nav-item done"><span class="nav-item-circle"><span class="fas fa-check"></span></span><span class="d-none d-md-block mt-1 fs--1">上傳照片</span></li>
                        <li class="nav-item active"><span class="nav-item-circle"><span class="far fa-edit"></span></span><span class="d-none d-md-block mt-1 fs--1">填寫基本資料</span></li>
                        <li class="nav-item"><span class="nav-item-circle"><span class="fas fa-thumbs-up"></span></span><span class="d-none d-md-block mt-1 fs--1">簽署約定書</span></li>
                    </ul>
                </div>
                <div class="px-3 py-4">
                    <h3 class="fw-bold me-3" style="color:#00af9a">填寫基本資料</h3>
                    <ul class="star_color fs--1">
                        <li>請核對以下資料，若有錯誤再請您修改內容</li>
                        <li>基本資料若填寫錯誤，將造成無法申辦</li>
                        <li>發票方式變更僅適用於變更後的訂單，先前的訂單開立方式不會變更</li>
                        <li> <span class="star_color me-1">*</span>為必填項目</li>
                    </ul>


                    <form class="row g-3" id="register-form">
                        <div class="col-12">
                            <label class="form-label"><span class="star_color me-1">*</span>請選擇發票索取方式</label>

                            @* 父 二聯電子發票*@
                            <div class="form-check ">
                                <input class="form-check-input" :class="{ 'error_border_radio': u.voice_type.error }" id="type1" type="radio" name="inlineRadioOptions" value="1" v-model="u.voice_type.v" @@change="changeVoice(1)" />
                                <label class="form-check-label" for="type1">二聯電子發票</label>
                            </div>
                            @* 子 二聯電子發票 子項目*@
                            <div v-show="showTypePage.v1">
                                <div class="ms-4">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" id="type1_1" type="radio" name="inlineRadioOptions1" value="1" v-model="u.voice_subtype.v" @@change="changeVoice1_1(1)" />
                                        <label class="form-check-label" for="type1_1">手機條碼載具</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" id="type1_2" type="radio" name="inlineRadioOptions1" value="2" v-model="u.voice_subtype.v" @@change="changeVoice1_1(2)" />
                                        <label class="form-check-label" for="type1_2">東元會員載具</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" id="type1_3" type="radio" name="inlineRadioOptions1" value="3" v-model="u.voice_subtype.v" @@change="changeVoice1_1(3)" />
                                        <label class="form-check-label" for="type1_3">自然人憑證載具</label>
                                    </div>
                                </div>
                                @* 子子 二聯電子發票 *@
                                @* 顯示 手機修碼 *@
                                <div class="ms-4">
                                    <div class="fs--1 helper-text" v-show="showTypePage.v1_1">
                                        若選擇手機條碼，請填寫您已歸戶之手機條碼，發票即會自動存入。詳情請參照財政部網站說明。
                                        (手機條碼格式:第一個字元/ + 7個英數字符號共八個字元)<br>
                                        您的手機條碼載具：
                                        <input :class="{ 'error_border': u.voice_txt_mobile.error === 'ng' }" class="form-control" type="text" v-model.trim="u.voice_txt_mobile.v" placeholder="EX：/AB0458D" />
                                    </div>
                                    @* 顯示 東元會員載具 *@
                                    <div class="fs--1 helper-text" v-show="showTypePage.v1_2">
                                        若選擇會員載具，發票即會儲存於會員的帳號內。 公司將於開獎月29日至電子發票整合服務平台下載中獎清冊(A 檔)，會員若有中獎本公司將於開獎日翌日起10日以手機簡訊通知會員，並以掛號郵寄方式提供中獎電子發票證明聯予中獎會員作為兌獎憑證。
                                        <input :class="{ 'error_border': u.voice_txt_oaddress.error === 'ng' }" class="form-control" placeholder="中獎發票寄送地址" type="text" v-model.trim="u.voice_txt_oaddress.v" maxlength="50" />
                                    </div>
                                    @* 顯示 自然人憑證載具 *@
                                    <div class="fs--1 helper-text" v-show="showTypePage.v1_3">
                                        <label class="form-label" for="card-name"><span class="star_color me-1">*</span>請輸入自然人憑證載具</label>
                                        <input :class="{ 'error_border': u.voice_txt_cq.error === 'ng' }" class="form-control" type="text" v-model.trim="u.voice_txt_cq.v" />
                                    </div>
                                </div>
                            </div>



                            @* 父 捐贈發票*@
                            <div class="form-check ">
                                <input class="form-check-input" :class="{ 'error_border_radio': u.voice_type.error }" id="type3" type="radio" name="inlineRadioOptions" value="3" v-model="u.voice_type.v" @@change="changeVoice(3)" />
                                <label class="form-check-label" for="type3">捐贈發票</label>
                            </div>
                            @* 子 捐贈發票*@
                            <div class="ms-4" v-show="showTypePage.v3">
                                <div class="fs--1 helper-text">若選擇發票捐贈，請任選預設的發票捐贈機構，系統會自動代入捐贈碼，即完成發票捐贈。</div>
                                <select :class="{ 'error_border': u.voice_txt_give.error === 'ng' }"
                                        class="form-select js-choice" v-model="u.voice_txt_give.v">
                                    <option value="">--請選擇單位--</option>
                                    <option value="88888">中華民國兒童癌症基金會</option>
                                    <option value="589">社團法人臺灣照顧生命協會(貓狗119)</option>
                                    <option value="51156">社團法人台灣公益聯盟</option>
                                </select>
                            </div>
                            <div v-if="u.voice_type.msg != '' ? true : false" class="error_msg" v-text="u.voice_type.msg"></div>
                            <div v-else-if="u.voice_txt_mobile.msg != '' ? true : false" class="error_msg" v-text="u.voice_txt_mobile.msg"></div>
                            <div v-else-if="u.voice_txt_give.msg != '' ? true : false" class="error_msg" v-text="u.voice_txt_give.msg"></div>
                            <div v-else-if="u.voice_txt_cq.msg != '' ? true : false" class="error_msg" v-text="u.voice_txt_cq.msg"></div>
                            @*<div v-else-if="u.voice_txt_comp.msg != '' ? true : false" class="error_msg" v-text="u.voice_txt_comp.msg"></div>*@
                            <div v-else-if="u.voice_txt_oaddress.msg != '' ? true : false" class="error_msg" v-text="u.voice_txt_oaddress.msg"></div>




                        </div>


                        <div class="col-md-6">
                            <label class="form-label" for="id"><span class="star_color me-1">*</span>身分證字號</label>
                            <input id="id" :class="[u.id.error == 'ng' ? 'error_border' : u.id.error == 'ok' ? 'nomal_border' : '','form-control']" type="text" autocomplete="on" id="card-name" v-model.trim="u.id.v" :maxlength="maxLength" />
                            <div v-if="u.id.msg != '' ? true : false" class="error_msg" v-text="u.id.msg"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="name"><span class="star_color me-1">*</span>姓名</label>
                            <input id="name" :class="[u.name.error == 'ng' ? 'error_border' : u.name.error == 'ok' ? 'nomal_border' : '','form-control']" type="text" v-model.trim="u.name.v" />
                            <div v-if="u.name.msg != '' ? true : false" class="error_msg" v-text="u.name.msg"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="birthDay"><span class="star_color me-1">*</span>生日</label>
                            <input id="birthDay" :class="[u.birthDay.error == 'ng' ? 'error_border' : u.birthDay.error == 'ng' ? 'nomal_border' : '','form-control datetimepicker']" data-options='{"disableMobile":true}' style="fill:none;background-color:white;" id="datepicker" type="text" v-model="u.birthDay.v" />
                            <div v-if="u.birthDay.msg != '' ? true : false" class="error_msg" v-text="u.birthDay.msg"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="tel">電話</label>
                            <input id="tel" :class="[u.tel.error == 'ng' ? 'error_border' :'','form-control']" type="text" v-model.trim="u.tel.v" maxlength="11" />
                            <span class="helper-text fs--1"> 範例 : 02-12345678 或 0912345678 </span>
                            <div v-if="u.tel.msg != '' ? true : false" class="error_msg" v-text="u.tel.msg"></div>
                        </div>
                        <div class="col-12">
                            <label class="form-label"><span class="star_color me-1">*</span>發證日期</label>
                            <div class="d-flex gap-3 three-col-wrapper">
                                <div>
                                    <input type="text" :class="[u.issue_date.error == 'ng' ? 'error_border' : u.issue_date.error == 'ok' ? 'nomal_border': '','form-control datepickerTW']" v-model="u.issue_date.v">
                                    <div v-if="u.issue_date.msg != '' ? true : false" class="error_msg" v-text="u.issue_date.msg"></div>
                                </div>
                                <div>
                                    <select :class="[u.issue_site.error == 'ng' ? 'error_border' : u.issue_site.error == 'ok' ? 'nomal_border': '','form-select js-choice']" v-model="u.issue_site.v" id="organizerSingle1" size="1" name="organizerSingle1" data-options='{"removeItemButton":true,"placeholder":true}'>
                                        <option value="">--發證縣市--</option>
                                        <option value="北縣">北縣</option>
                                        <option value="宜縣">宜縣</option>
                                        <option value="桃縣"> 桃縣</option>
                                        <option value="竹縣"> 竹縣</option>
                                        <option value="苗縣"> 苗縣</option>
                                        <option value="中縣"> 中縣</option>
                                        <option value="彰縣"> 彰縣</option>
                                        <option value="投縣"> 投縣</option>
                                        <option value="雲縣"> 雲縣</option>
                                        <option value="嘉縣"> 嘉縣</option>
                                        <option value="南縣"> 南縣</option>
                                        <option value="高縣"> 高縣</option>
                                        <option value="屏縣"> 屏縣</option>
                                        <option value="東縣"> 東縣</option>
                                        <option value="花縣"> 花縣</option>
                                        <option value="澎縣"> 澎縣</option>
                                        <option value="基市"> 基市</option>
                                        <option value="竹市"> 竹市</option>
                                        <option value="嘉市"> 嘉市</option>
                                        <option value="連江"> 連江</option>
                                        <option value="金門"> 金門</option>
                                        <option value="北市"> 北市</option>
                                        <option value="高市"> 高市</option>
                                        <option value="新北市"> 新北市</option>
                                        <option value="中市"> 中市</option>
                                        <option value="南市"> 南市</option>
                                        <option value="桃市">桃市</option>
                                    </select>
                                    <div v-if="u.issue_site.msg != '' ? true : false" class="error_msg" v-text="u.issue_site.msg"></div>
                                </div>
                                <div>
                                    <select :class="[u.issue_reason.error == 'ng' ? 'error_border' : u.issue_reason.error == 'ok' ? 'nomal_border': '','form-select js-choice']" v-model="u.issue_reason.v" id="organizerSingle" size="1" name="organizerSingle" data-options='{"removeItemButton":true,"placeholder":true}'>
                                        <option value="">--領補換類別--</option>
                                        <option value="初發">初發</option>
                                        <option value="補發">補發</option>
                                        <option value="換發">換發</option>
                                    </select>
                                    <div v-if="u.issue_reason.msg != '' ? true : false" class="error_msg" v-text="u.issue_reason.msg"></div>
                                </div>

                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="card-name"><span class="star_color me-1">*</span>戶籍地址</label>
                            <input :class="[u.address.error == 'ng' ? 'error_border' : u.address.error == 'ok' ? 'nomal_border' : '','form-control']" type="text" v-model.trim="u.address.v" maxlength="50" />
                            <div v-if="u.address.msg != '' ? true : false" class="error_msg" v-text="u.address.msg"></div>
                        </div>
                        <div class="col-12">
                            <label class="form-label me-2" for="current-address"><span class="star_color me-1">*</span>居住地址</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" id="address_type" type="checkbox" :value="u.address_type.v" @@change="change(u.address_type.v)" v-model="u.address_type.v" maxlength="50" />
                                <label class="form-check-label" for="address_type">同戶籍地址</label>
                            </div>
                            <input id="current-address" :class="[u.current_address.error == 'ng' ? 'error_border' : u.current_address.error == 'ok' ? 'nomal_border' : '','form-control']" type="text" v-model.trim="u.current_address.v" />
                            <div v-if="u.current_address.msg != '' ? true : false" class="error_msg" v-text="u.current_address.msg"></div>
                        </div>

                        <div class="col-12">
                            <label class="form-label"><span class="star_color me-1">*</span>聯絡人</label>
                            <div class="d-flex gap-3 three-col-wrapper">
                                <div>
                                    <input id="link-name" :class="[u.link_name.error=='ng' ? 'error_border' : u.link_name.error == 'ok' ? 'nomal_border' : '','form-control mb-1']" type="text" placeholder="姓名" v-model.trim="u.link_name.v" />
                                    <div v-if="u.link_name.msg != '' ? true : false" class="error_msg" v-text="u.link_name.msg"></div>
                                </div>
                                <div>
                                    <input :class="[u.link_mobile.error == 'ng' ? 'error_border' : u.link_mobile.error == 'ok' ? 'nomal_border' : '','form-control']" type="text" placeholder="手機號碼" v-model.trim="u.link_mobile.v" maxlength="11" />
                                    <div v-if="u.link_mobile.msg != '' ? true : false" class="error_msg" v-text="u.link_mobile.msg"></div>
                                </div>
                                <div>
                                    <select :class="[u.link_relation.error == 'ng' ? 'error_border' : u.link_relation.error == 'ok' ? 'nomal_border' : '','form-select js-choice']" v-model.trim="u.link_relation.v" id="organizerSingle" size="1" name="organizerSingle" data-options='{"removeItemButton":true,"placeholder":true}'>
                                        <option value="">--聯絡人關係--</option>
                                        <option value="01">父子</option>
                                        <option value="02">父女</option>
                                        <option value="03">母子</option>
                                        <option value="04">母女</option>
                                        <option value="05">兄弟</option>
                                        <option value="06">姊妹</option>
                                        <option value="07">朋友</option>
                                        <option value="08">兄妹</option>
                                        <option value="09">姑叔姪</option>
                                        <option value="10">姨甥</option>
                                        <option value="11">夫妻</option>
                                        <option value="12">表兄弟姊妹</option>
                                        <option value="13">同事</option>
                                        <option value="14">姐弟</option>
                                        <option value="15">同學</option>
                                        <option value="16">老闆</option>
                                        <option value="17">堂兄弟姊妹</option>
                                        <option value="18">祖孫</option>
                                        <option value="19">外祖孫</option>
                                        <option value="20">公婆媳</option>
                                        <option value="21">姑嫂</option>
                                        <option value="22">伯父母</option>
                                        <option value="23">舅嬸</option>
                                        <option value="24">姻親</option>
                                        <option value="25">乾父子</option>
                                        <option value="26">乾母子</option>
                                        <option value="27">繼父</option>
                                        <option value="28">繼母</option>
                                        <option value="29">岳父母</option>
                                        <option value="30">情侶</option>
                                    </select>
                                    <div v-if="u.link_relation.msg != '' ? true : false" class="error_msg" v-text="u.link_relation.msg"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="card-name"><span class="star_color me-1">*</span>就業狀態</label>
                            <div :class="u.work_type.error ? 'error_border' : ''">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" id="work_type1" type="radio" name="work_typeRadioOptions" value="1" v-model="u.work_type.v" />
                                    <label class="form-check-label" for="work_type1">就業中</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" id="work_type2" type="radio" name="work_typeRadioOptions" value="2" v-model="u.work_type.v" />
                                    <label class="form-check-label" for="work_type2">學生</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" id="work_type3" type="radio" name="work_typeRadioOptions" value="3" v-model="u.work_type.v" />
                                    <label class="form-check-label" for="work_type3">其他</label>
                                </div>
                            </div>
                            <div v-if="u.work_type.msg != '' ? true : false" class="error_msg" v-text="u.work_type.msg"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="work_name"><span class="star_color me-1">*</span>公司名稱/學校</label>
