<link href="~/css/default.css" rel="stylesheet" />
<link href="~/css/nav-wizard.css" rel="stylesheet" />
<link href="~/css/btn/btn.css" rel="stylesheet" />

<style>
    [v-cloak] {
        display: none !important;
    }

    .twcaClauseWrapper {
        max-height: 400px;
        overflow: auto;
        padding: 1rem;
        background-color: rgb(249 250 251);
        border-radius: 0.5rem;
        line-height: 180%;
    }

    .form-check-input,
    .form-check-label {
        cursor: pointer;
    }

    .form-check-input:disabled,
    .form-check-input:disabled ~ .form-check-label {
        cursor: not-allowed;
    }

    .error_msg {
        width: 100%;
        font-size: 75%;
        color: #e63757;
        font-style: italic;
    }

    .error_border_checkbox {
        border: solid 1px #e63757 !important;
    }
</style>



<div class="main" id="app">

    <div class="row justify-content-center pt-0 pt-md-6">
        <div class="col-sm-10 col-lg-7 col-xxl-5 px-0 px-md-3">
            <div class="card mb-5">
                <div class="card-header bg-light pt-3 pb-2">
                    @* 流程 *@
                    <ul class="nav justify-content-between nav-wizard">
                        <li class="nav-item done"><span class="nav-item-circle-parent"><span class="nav-item-circle"><span class="fas fa-check"></span></span></span><span class="d-none d-md-block mt-1 fs--1">註冊會員</span></li>
                        <li class="nav-item done"><span class="nav-item-circle"><span class="fas fa-check"></span></span><span class="d-none d-md-block mt-1 fs--1">上傳照片</span></li>
                        <li class="nav-item done"><span class="nav-item-circle"><span class="fas fa-check"></span></span><span class="d-none d-md-block mt-1 fs--1">填寫基本資料</span></li>
                        <li class="nav-item active"><span class="nav-item-circle"><span class="fas fa-thumbs-up"></span></span><span class="d-none d-md-block mt-1 fs--1">簽署約定書</span></li>
                    </ul>
                </div>
                <div class="py-4">
                    <div class="tab-content">
                        <div class="tab-pane active px-sm-3" role="tabpanel">
                            <div class="overflow-hidden z-index-1">
                                <div class="card-body p-0">
                                    <div class="row g-0 h-100">
                                        <div class="col-md-12 d-flex flex-center">
                                            <div class="px-3" v-cloak>
                                                <h3 class="fw-bold" style="color:#00af9a">門號驗證</h3>
                                                <div  class="twcaClauseWrapper mb-3" @@scroll="handleScroll">
                                                    <div v-html="html_data" ></div>
                                                </div>

                                                <div class="form-check">
                                                    <input class="form-check-input" :class= " {'error_border_checkbox':u.agree.error === 'ng'}" id="twcaCheck" type="checkbox" v-model="u.agree.v" :disabled="isDisabled" />
                                                    <label class="form-check-label" for="twcaCheck" style="font-size: 1rem;">我已詳閱服務使用者約定條款及隱私權告知條款</label>
                                                    <div v-if="u.agree.msg != '' ? true : false" class="error_msg" v-text="u.agree.msg"></div>
                                                </div>

                                                <button class="btn btn-primary ms-auto mt-4" @@click="Send(u)" type="button">下一步<span class="fas fa-chevron-right ms-2"> </span></button>
       
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>

    </div>





</div>



<script src="~/js/version-loader.js?v=1"></script>
<script>
    loadVersionedScripts([
        '@Url.Content("~/js/common.js")',
        '@Url.Content("~/js/twcaVerify_2.js")'
    ]);
</script>



