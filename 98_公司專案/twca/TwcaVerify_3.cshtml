<link href="~/css/default.css" rel="stylesheet" />
<link href="~/css/nav-wizard.css" rel="stylesheet" />
<link href="~/css/btn/btn.css" rel="stylesheet" />

<style>
    [v-cloak] {
        display: none !important;
    }

    .error_border {
        border: solid 1px red !important;
        border-color: #e63757;
        padding-right: calc(1.5em + 0.625rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23e63757'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23e63757' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.15625rem) center;
        background-size: calc(0.75em + 0.3125rem) calc(0.75em + 0.3125rem);
    }

    .nomal_border {
        border: solid 1px #00d27a !important;
        border-color: #00d27a;
        padding-right: calc(1.5em + 0.625rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2300d27a' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.15625rem) center;
        background-size: calc(0.75em + 0.3125rem) calc(0.75em + 0.3125rem);
    }

    .error_msg {
        width: 100%;
        margin-top: 0.25rem;
        font-size: 75%;
        color: #e63757;
        font-style: italic;
    }

    .star_color {
        color: #E4603C;
    }

    .form-control-plaintext:focus {
        outline: none;
        box-shadow: none;
    }
</style>

<div class="main" id="app">

    <div class="row justify-content-center pt-0 pt-md-6">
        <div class="col-sm-10 col-lg-7 col-xxl-5 px-0 px-md-3">

            <div class="card mb-5">
                <div class="card-header bg-light pt-3 pb-2">
                    @* 流程 *@
                    <ul class="nav justify-content-between nav-wizard">
                        <li class="nav-item done"><span class="nav-item-circle-parent"><span class="nav-item-circle"><span class="fas fa-check"></span></span></span><span class="d-none d-md-block mt-1 fs--1">註冊會員</span></li>
                        <li class="nav-item done"><span class="nav-item-circle"><span class="fas fa-check"></span></span><span class="d-none d-md-block mt-1 fs--1">上傳照片</span></li>
                        <li class="nav-item done"><span class="nav-item-circle"><span class="fas fa-check"></span></span><span class="d-none d-md-block mt-1 fs--1">填寫基本資料</span></li>
                        <li class="nav-item active"><span class="nav-item-circle"><span class="fas fa-thumbs-up"></span></span><span class="d-none d-md-block mt-1 fs--1">簽署約定書</span></li>
                    </ul>
                </div>
                <div class="py-4">
                    <div class="tab-content">
                        <div class="tab-pane active" role="tabpanel">
                            <div class="overflow-hidden z-index-1">
                                <div class="card-body p-0">
                                    <div class="row g-0 h-100">
                                        <div>
                                            <div class="px-3" v-cloak>
                                                <h3 class="fw-bold" style="color:#00af9a">門號驗證</h3>

                                                <form>
                                                    <div class="mb-3 row">
                                                        <label for="id" class="col-sm-2 col-form-label">身分證字號</label>
                                                        <div class="col-sm-10">
                                                            <input type="text" readonly class="form-control-plaintext" id="id" :value="u.id.v">
                                                        </div>
                                                    </div>

                                                    <div class="mb-3 row">
                                                        <label for="phone" class="col-sm-2 col-form-label">手機號碼</label>
                                                        <div class="col-sm-10">
                                                            <input type="text" readonly class="form-control-plaintext" id="phone" :value="u.mobile.v">
                                                        </div>
                                                    </div>

                                                    <div class="mb-3 row">
                                                        <label for="phone" class="col-sm-2 col-form-label"><span class="star_color">*</span>電信公司</label>
                                                        <div class="col-sm-10">
                                                            <select id="telecom" :class="[u.type.error == 'ng' ? 'error_border' : u.type.error == 'ok' ? 'nomal_border' : '','form-select js-choice']" v-model="u.type.v" id="organizerSingle" size="1" name="organizerSingle" data-options='{"removeItemButton":true,"placeholder":true}'>
                                                                <option value="">--請選擇--</option>
                                                                <option value="46692">中華電信</option>
                                                                <option value="46601">遠傳電信(含原亞太電信)</option>
                                                                <option value="46697">台灣大哥大(含原台灣之星)</option>
                                                                @*<option value="46605">亞太電信</option>*@
                                                                @*<option value="46689">台灣之星</option>*@

                                                            </select>
                                                            <div v-if="u.type.msg != '' ? true : false" class="error_msg" v-text="u.type.msg"></div>
                                                        </div>
                                                    </div>

                                                    <button :disabled="hasDisabled" class="btn btn-primary ms-auto mt-4" @@click="Send(u)" type="button">送 出<span class="fas fa-chevron-right ms-2" data-fa-transform="shrink-3"> </span></button>

                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>

    </div>


</div>



<script src="~/js/version-loader.js?v=1"></script>
<script>
    loadVersionedScripts([
        '@Url.Content("~/js/common.js")',
        '@Url.Content("~/js/twcaVerify_3.js")'
    ]);
</script>


