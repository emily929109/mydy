<link href="~/css/default.css" rel="stylesheet" />
<link href="~/css/nav-wizard.css" rel="stylesheet" />
<link href="~/css/btn/btn.css" rel="stylesheet" />

<style>  
    .star_color {
        color: #E4603C;
    }

    [v-cloak] {
        display: none !important;
    }
       
    form.not-myself,
    form.myself {
        padding: 1rem;
        background-color: rgb(249 250 251 );
        border-radius: 0.5rem;
        color: var(--color-gray-7);
        line-height: 180%
    }
    
</style>



<div class="main" id="app" v-cloak>

    <div class="row justify-content-center pt-0 pt-md-6">
        <div class="col-sm-10 col-lg-7 col-xxl-5 px-0 px-md-3">
            <div class="card mb-5">
                <div class="card-header bg-light pt-3 pb-2">
                    @* 流程 *@
                    <ul class="nav justify-content-between nav-wizard">
                        <li class="nav-item done"><span class="nav-item-circle-parent"><span class="nav-item-circle"><span class="fas fa-check"></span></span></span><span class="d-none d-md-block mt-1 fs--1">註冊會員</span></li>
                        <li class="nav-item done"><span class="nav-item-circle"><span class="fas fa-check"></span></span><span class="d-none d-md-block mt-1 fs--1">上傳照片</span></li>
                        <li class="nav-item done"><span class="nav-item-circle"><span class="fas fa-check"></span></span><span class="d-none d-md-block mt-1 fs--1">填寫基本資料</span></li>
                        <li class="nav-item active"><span class="nav-item-circle"><span class="fas fa-thumbs-up"></span></span><span class="d-none d-md-block mt-1 fs--1">簽署約定書</span></li>
                    </ul>
                </div>
                <div class="py-4">
                    <div class="tab-content">
                        <div class="tab-pane active px-sm-3" role="tabpanel">
                            <div class="overflow-hidden z-index-1">
                                <div class="card-body p-0">
                                    <div class="row g-0 h-100">
                                        <div class="col-md-12 d-flex flex-center">
                                            <div class="px-3" >
                                                <div class="fs-3 fw-bold mb-2" style="color:#00af9a">門號驗證</div>
                                                <p class="fs-0 fs-lg-0" style="color:black">
                                                    <div class="mb-2">請選擇：</div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" id="inlineRadio1" type="radio" name="inlineRadioOptions1" value="0" checked="checked" v-model="u.isSelf" @@change="changed('0')" />
                                                        <label class="form-check-label fs-0 fs-lg-0" for="inlineRadio1">門號為本人</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" id="inlineRadio2" type="radio" name="inlineRadioOptions2" value="1" v-model="u.isSelf" @@change="changed('1')" />
                                                        <label class="form-check-label fs-0 fs-lg-0" style="color:black" for="inlineRadio2">門號非本人/或是易付卡</label>
                                                    </div>
                                                </p>
                                                <form class="myself" v-show="showMsg">
                                                    @*<form>*@
                                                    <p>
                                                        系統將使用您的手機門號進行驗證，請閱讀以下注意事項：
                                                    </p>
                                                    <ol>
                                                        <li>請確定您目前用於連線的門號為您本人申請之門號，若為親友、公司等申辦門號非本人，或使用易付卡，請選非本人選項</li>
                                                        <li>請先關閉您手機的Wi-Fi並使用4G/5G網路</li>
                                                        <li>如您使用電腦操作，請您一樣先行關閉您手機的Wi-Fi並使用4G/5G網路，並於後續驗證過程中開啟手機的QRCode掃描工具，掃描電腦螢幕上出現的QRCode即可</li>
                                                        <li>本服務不支援預付卡、外國人、企業門號或其他功能受限門號(如有問題請洽您的電信業者詢問使用服務之資格)</li>

                                                    </ol>
                                                    <div class="d-flex form-check gap-3">
                                                        <input class="form-check-input" id="flexCheckIndeterminate" type="checkbox" v-model="u.agree.v" style="font-size:1rem" />
                                                        <label class="form-check-label " for="flexCheckIndeterminate" style="font-size:1rem">我已關閉手機的WI-FI並使用4G/5G網路</label>
                                                        @*<div v-if="u.agree.msg != '' ? true : false" class="error_msg" v-text="u.agree.msg"></div>*@
                                                    </div>
                                                    @*<div class="form-check"> </div>*@
                                                </form>

                                                @*非本人也顯示訊息 開始*@
                                                <form class="not-myself" v-show="!showMsg">
                                                    @*<form>*@
                                                    <p>
                                                        系統將使用您的手機門號進行驗證，請閱讀以下注意事項：
                                                    </p>
                                                    <ol>
                                                        <li>請確定您目前用於連線的門號為您本人申請之門號，若為親友、公司等申辦門號非本人，或使用易付卡，請選非本人選項</li>
                                                        <li>請先關閉您手機的Wi-Fi並使用4G/5G網路</li>
                                                        <li>如您使用電腦操作，請您一樣先行關閉您手機的Wi-Fi並使用4G/5G網路，並於後續驗證過程中開啟手機的QRCode掃描工具，掃描電腦螢幕上出現的QRCode即可</li>
                                                        <li>本服務不支援預付卡、外國人、企業門號或其他功能受限門號(如有問題請洽您的電信業者詢問使用服務之資格)</li>
                                                    </ol>


                                                </form>
                                                @*非本人也顯示訊息 結束*@

                                                <button class="btn btn-primary ms-auto mt-4" @@click="Send(u)" type="button">下一步<span class="fas fa-chevron-right ms-2"> </span></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>

    </div>
</div>


<script src="~/js/version-loader.js?v=1"></script>
<script>
    loadVersionedScripts([
        '@Url.Content("~/js/common.js")',
        '@Url.Content("~/js/twcaVerify_1.js")'
    ]);
</script>


